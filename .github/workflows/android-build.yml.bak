name: Build Android APK (debug)

on:
  push:
    branches: [ rama-web ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      ANDROID_SDK_ROOT: /usr/local/lib/android/sdk
      NODE_ENV: production

    steps:
    - name: Checkout repo
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: temurin
        java-version: 17

    - name: Set up Node.js
      uses: actions/setup-node@v4
      with:
        node-version: 18

    - name: Cache Gradle & npm
      uses: actions/cache@v4
      with:
        path: |
          ~/.gradle/caches
          ~/.gradle/wrapper
          mobile/node_modules
        key: ${{ runner.os }}-gradle-${{ hashFiles('**/*.gradle*','**/gradle-wrapper.properties','mobile/package-lock.json','mobile/yarn.lock') }}

    - name: Accept Android SDK licenses & install build tools
      run: |
        sudo chown -R $USER $ANDROID_SDK_ROOT || true
        yes | $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --sdk_root=$ANDROID_SDK_ROOT --licenses || true
        $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --sdk_root=$ANDROID_SDK_ROOT "platform-tools" "platforms;android-33" "build-tools;33.0.0" || true

    - name: Install node dependencies
      working-directory: mobile
      run: |
        if [ -f package-lock.json ]; then npm ci; else npm install; fi
        
    - name: Ensure autolinking.json exists
      run: |
        mkdir -p mobile/android/build/generated/autolinking
        if [ ! -f mobile/android/build/generated/autolinking/autolinking.json ]; then
          echo '{}' > mobile/android/build/generated/autolinking/autolinking.json
          echo "Created stub autolinking.json"
        else
          echo "autolinking.json already exists"
        fi

    - name: Build debug APK
      working-directory: mobile/android
      run: |
        chmod +x ./gradlew
        ./gradlew assembleDebug --no-daemon

    - name: Upload debug APK
      uses: actions/upload-artifact@v4
      with:
        name: app-debug-apk
        path: mobile/android/app/build/outputs/apk/debug/app-debug.apk
